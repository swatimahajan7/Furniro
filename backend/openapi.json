    "/api/v1/products": {
      "get": {
        "operationId": "list_products_api_v1_products_get",
        "parameters": [
          {
            "description": "Case-insensitive match on name and subtitle",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive match on name and subtitle",
              "title": "Q"
            }
          },
          {
            "description": "Category slug; repeat for several, e.g. ?category=sofas",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "default": [],
              "description": "Category slug; repeat for several, e.g. ?category=sofas",
              "items": {
