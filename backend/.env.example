# Copy to backend/.env and adjust. Every key is optional in dev; defaults live in app/core/config.py.

# dev | prod   (prod requires JWT_SECRET)
APP_ENV=dev
LOG_LEVEL=INFO

# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://furniro:furniro@localhost:5432/furniro
DATABASE_URL=sqlite:///./furniro.db
SEED_ON_STARTUP=true

# Must be set to a long random value when APP_ENV=prod
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_MINUTES=1440

# Comma-separated list
CORS_ORIGINS=http://localhost:5180
MEDIA_DIR=media

CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
CURRENCY_LOCALE=en-US

