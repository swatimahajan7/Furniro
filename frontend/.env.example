# Copy to frontend/.env.local to override. All values are optional.

# Base path the app calls. In dev, Vite proxies /api and /media to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8100

# Dev server port (default 5180; 5173 is taken by other local projects)
WEB_PORT=5180
