# Furniro on a VM with Podman: settings for deploy/podman/furniro.sh.
# `./furniro.sh init` copies this file to furniro.env (git-ignored) and fills in the two secrets.

# The address people type in the browser: http://<VM address>:<WEB_PORT>
PUBLIC_URL=http://203.0.113.10:5180

# VM ports. Only these two are published; PostgreSQL, nginx and the API's own port stay inside the pod.
WEB_PORT=5180
API_PORT=8100

# Generated by `furniro.sh init` when empty. Letters and digits only (they are used inside a URL).
POSTGRES_PASSWORD=
JWT_SECRET=

# Pod, container and volume names start with this, so they cannot clash with other apps on the VM.
NAME=furniro
